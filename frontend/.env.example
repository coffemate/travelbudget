# Development: keep /api and use Vite proxy to local worker
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8787

# Production: point to deployed worker with /api prefix
# VITE_API_URL=https://your-worker.workers.dev/api

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
